<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.Pane?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.geometry.Insets?>
<VBox fx:controller="iut.gon.gribouille.controleurs.CouleursController" prefHeight="200.0" prefWidth="120.0"
      spacing="5.0" style="-fx-background-color: #CCCCCC;" xmlns="http://javafx.com/javafx/21.0.2"
      xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
    </padding>
    <ColorPicker prefWidth="110.0" fx:id="ColorPicker"/>
    <TilePane hgap="5.0" prefHeight="200.0" prefWidth="110.0" vgap="5.0">
        <VBox.margin>
            <Insets top="5.0"/>
        </VBox.margin>
        <Rectangle onMousePressed="#onPaletteClic" arcHeight="2.0" arcWidth="2.0" fill="RED" height="45.0" stroke="BLACK" strokeType="INSIDE"
                   width="45.0"/>
        <Rectangle onMousePressed="#onPaletteClic" arcHeight="2.0" arcWidth="2.0" fill="#00ff00" height="45.0" stroke="BLACK" strokeType="INSIDE"
                   width="45.0"/>
        <Rectangle onMousePressed="#onPaletteClic" arcHeight="2.0" arcWidth="2.0" fill="BLUE" height="45.0" stroke="BLACK" strokeType="INSIDE"
                   width="45.0"/>
        <Rectangle onMousePressed="#onPaletteClic" arcHeight="2.0" arcWidth="2.0" fill="CYAN" height="45.0" stroke="BLACK" strokeType="INSIDE"
                   width="45.0"/>
        <Rectangle onMousePressed="#onPaletteClic" arcHeight="2.0" arcWidth="2.0" fill="MAGENTA" height="45.0" stroke="BLACK" strokeType="INSIDE"
                   width="45.0"/>
        <Rectangle onMousePressed="#onPaletteClic" arcHeight="2.0" arcWidth="2.0" fill="YELLOW" height="45.0" stroke="BLACK" strokeType="INSIDE"
                   width="45.0"/>
        <Rectangle onMousePressed="#onPaletteClic" arcHeight="2.0" arcWidth="2.0" height="45.0" stroke="BLACK" strokeType="INSIDE" width="45.0"/>
        <Rectangle onMousePressed="#onPaletteClic" arcHeight="2.0" arcWidth="2.0" fill="WHITE" height="45.0" stroke="BLACK" strokeType="INSIDE"
                   width="45.0"/>
    </TilePane>
</VBox>